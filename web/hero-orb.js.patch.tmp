      // If the sun is below the horizon, hide it
      if (body.elevation < NIGHT_FADE_DEG) {
        orb.style.opacity = '0';
        orb.style.display = 'none';
        return api;
      }

      // Keep the orb visible when the body is valid and above the horizon.
      if (!body || !Number.isFinite(body.elevation)) {
        orb.style.display = 'block';
        orb.style.opacity = '0.8';
        return api;
      }
