{
  "rules": {
    ".read": false,
    ".write": false,
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": false
      }
    },
    "publicProfiles": {
      ".read": "auth != null",
      ".indexOn": [
        "city",
        "slug",
        "available"
      ],
      "$uid": {
        ".write": "auth != null && auth.uid == $uid && !root.child('banned').child($uid).exists() || auth != null && root.child('admins').child(auth.uid).val() == true",
        ".validate": "newData.hasChildren(['displayName','city','stageName','slug','profileComplete']) && newData.child('displayName').isString() && newData.child('displayName').val().length <= 60 && newData.child('city').isString() && newData.child('city').val().length <= 60 && newData.child('stageName').isString() && newData.child('stageName').val().length <= 80 && newData.child('slug').isString() && newData.child('slug').val().length <= 80 && newData.child('profileComplete').isBoolean() && (!newData.child('phonePublic').val() || (newData.child('phonePublic').isBoolean() && newData.child('phone').isString() && newData.child('phone').val().length <= 20)) && (!newData.hasChild('phone') || newData.child('phonePublic').val() == true)"
      }
    },
    "riders": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid || auth != null && root.child('admins').child(auth.uid).val() == true",
        ".write": "auth != null && auth.uid == $uid && !root.child('banned').child($uid).exists()",
        "profile": {
          ".validate": "newData.hasChildren(['displayName']) && newData.child('displayName').isString() && newData.child('displayName').val().length <= 70"
        }
      }
    },
    "posts": {
      ".read": "auth != null",
      ".indexOn": [
        "stageId",
        "expiresAt",
        "createdAt"
      ],
      "$postId": {
        ".write": "auth != null && !root.child('banned').child(auth.uid).exists() && ((!data.exists() && newData.child('authorId').val() == auth.uid) || (data.exists() && data.child('authorId').val() == auth.uid) || root.child('admins').child(auth.uid).val() == true)",
        ".validate": "newData.hasChildren(['authorId','authorName','text','createdAt','expiresAt','likeCount']) && newData.child('text').isString() && newData.child('text').val().length > 0 && newData.child('text').val().length <= 280"
      }
    },
    "postLikes": {
      "$postId": {
        "$uid": {
          ".write": "auth != null && auth.uid == $uid && !root.child('banned').child(auth.uid).exists()",
          ".validate": "newData.val() == true"
        }
      }
    },
    "challenges": {
      ".read": "auth != null",
      "$weekKey": {
        ".write": "auth != null && root.child('admins').child(auth.uid).val() == true || auth != null && !data.exists()",
        "$challengeId": {
          ".validate": "newData.hasChildren(['title','description','type','target','badgeId'])"
        }
      }
    },
    "challengeProgress": {
      ".read": "auth != null",
      "$weekKey": {
        "$challengeId": {
          "$uid": {
            ".write": "auth != null && auth.uid == $uid && !root.child('banned').child(auth.uid).exists() || auth != null && root.child('admins').child(auth.uid).val() == true",
            ".validate": "newData.hasChildren(['progress','completed','firstName','updatedAt']) && newData.child('progress').isNumber() && newData.child('progress').val() >= 0 && newData.child('completed').isBoolean() && newData.child('firstName').isString() && newData.child('firstName').val().length <= 40"
          }
        }
      }
    },
    "presence": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid == $uid",
        ".validate": "newData.hasChildren(['geohash','updatedAt','visible']) && newData.child('geohash').isString() && newData.child('geohash').val().length == 6 && newData.child('visible').isBoolean()"
      }
    },
    "heatmapCells": {
      ".read": "auth != null",
      ".write": "auth != null && (!data.exists() || newData.child('updatedAt').val() >= data.child('updatedAt').val())",
      "$cellId": {
        ".validate": "newData.hasChildren(['count','updatedAt']) && newData.child('count').isNumber() && newData.child('count').val() >= 0 && newData.child('count').val() <= 100000"
      }
    },
    "reports": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() == true",
      "$reportId": {
        ".write": "auth != null && ((!data.exists() && newData.child('reporterUid').val() == auth.uid) || root.child('admins').child(auth.uid).val() == true)"
      }
    },
    "banned": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() == true",
      "$uid": {
        ".write": "auth != null && root.child('admins').child(auth.uid).val() == true"
      }
    }
  }
}