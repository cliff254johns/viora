{
  "name": "viora-engineering-quality-gates",
  "private": true,
  "type": "module",
  "scripts": {
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:integration": "node --test tests/integration/*.test.mjs",
    "test:contracts": "node scripts/viora-engineering-checks.mjs",
    "test": "npm run test:contracts && npm run test:unit",
    "docs:generate": "node scripts/generate-engineering-docs.mjs",
    "review:changes": "node scripts/review-changes.mjs",
    "test:e2e": "playwright test",
    "test:cloudflare": "vitest run --config vitest.config.mjs",
    "test:all": "npm test && npm run test:cloudflare"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "firebase-admin": "^13.5.0",
    "@aws-sdk/client-s3": "^3.900.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@axe-core/playwright": "^4.10.2",
    "vitest": "^4.1.0",
    "@cloudflare/vitest-plugin": "^1.0.0"
  }
}
